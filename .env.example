# Copy to .env.local and fill in. Never commit real keys.
# Server-side only: used by app/api/extract/route.ts for live checks.
ANTHROPIC_API_KEY=your-key-here
# Live model on the public site (spec.md > Decisions). Use claude-haiku-5-5 while developing.
FL_LIVE_MODEL=claude-sonnet-5-5
# Best-effort cap on live checks per day (the hard cap is the console spend limit).
FL_DAILY_LIVE_LIMIT=25
